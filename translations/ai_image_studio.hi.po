msgstr "आरंभिक पीढ़ी..."

msgid ""
"Your request is being sent to the selected provider. Keep this page open."
msgstr "आपका अनुरोध चयनित प्रदाता को भेजा जा रहा है। इस पेज को खुला रखें."

msgid "Session title"
msgstr "सत्र का शीर्षक"

msgid "Start from"
msgstr "से शुरू करें"

msgid "A text prompt"
msgstr "एक पाठ संकेत"

