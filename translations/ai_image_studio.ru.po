"Поставщик может ограничить или скорректировать запрошенную продолжительность."

msgid "Automatic matches the selected source image where possible."
msgstr ""
"Автоматически соответствует выбранному исходному изображению, где это "
"возможно."

msgid "480p — faster and lower cost"
msgstr "480p — быстрее и дешевле"

msgid "720p — standard"
msgstr "720p — стандартное"

msgid "1080p — provider dependent"
msgstr "1080p — зависит от провайдера"

msgid "Text-to-video providers may not support 1080p."
msgstr "Поставщики преобразования текста в видео могут не поддерживать 1080p."

