msgstr "Kutoa beji kwenye video kunahitaji kiendelezi cha PHP GD."

msgid "The generated video could not be opened for badge rendering."
msgstr "Video iliyotolewa haikuweza kufunguliwa kwa ajili ya utoaji wa beji."

msgid "Temporary files for video badge rendering could not be created."
msgstr "Faili za muda za utoaji beji za video hazikuweza kuundwa."

msgid "FFmpeg could not render the badge into the video: @message"
msgstr "FFmpeg haikuweza kutoa beji kwenye video: @message"

msgid "FFmpeg returned an empty badged video."
msgstr "FFmpeg ilirudisha video tupu yenye beji."

