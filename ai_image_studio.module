<?php

/**
 * @file
 * Hooks for AI Image Studio.
 */

declare(strict_types=1);

use Drupal\Core\Database\Query\AlterableInterface;
use Drupal\Core\Entity\EntityInterface;
use Drupal\Core\Form\FormStateInterface;
use Drupal\file\FileInterface;
use Drupal\media\Entity\MediaType;

/**
 * Implements hook_query_ai_image_studio_session_access_alter().
 */
function ai_image_studio_query_ai_image_studio_session_access_alter(AlterableInterface $query): void {
  $account = \Drupal::currentUser();
  if ($account->hasPermission('administer ai image studio')
    || $account->hasPermission('view any ai image studio session')) {
    return;
  }

  if (!$account->hasPermission('access ai image studio')) {
    $query->where('1 = 0');
    return;
  }

  foreach (ai_image_studio_query_table_aliases($query, 'ai_image_studio_session') as $alias) {
    $query->condition($alias . '.uid', $account->id());
  }
}

/**
 * Implements hook_query_ai_image_studio_turn_access_alter().
 */
function ai_image_studio_query_ai_image_studio_turn_access_alter(AlterableInterface $query): void {
  $account = \Drupal::currentUser();
  if ($account->hasPermission('administer ai image studio')
    || $account->hasPermission('view any ai image studio session')) {
    return;
  }

  if (!$account->hasPermission('access ai image studio')) {
    $query->where('1 = 0');
    return;
  }

  $connection = \Drupal::database();
  foreach (ai_image_studio_query_table_aliases($query, 'ai_image_studio_turn') as $alias) {
    $session_query = $connection->select('ai_image_studio_session', 'ais_access');
    $session_query->addExpression('1');
    $session_query->where(
      'ais_access.id = ' . $connection->escapeTable($alias) . '.session_id',
    );
    $session_query->condition('ais_access.uid', $account->id());
    $query->exists($session_query);
  }
}

/**
 * Finds every alias at which a Views access-tagged table was joined.
 *
 * @return string[]
 *   Query table aliases.
 */
function ai_image_studio_query_table_aliases(AlterableInterface $query, string $table_name): array {
  $aliases = [];
  foreach ($query->getTables() as $alias => $table) {
    if (($table['table'] ?? NULL) === $table_name) {
      $aliases[] = $alias;
    }
  }
  return $aliases;
}

/**
 * Implements hook_module_implements_alter().
 */
function ai_image_studio_module_implements_alter(
  array &$implementations,
  string $hook,
): void {
  // ai_media_image creates the image_source element in its form alter. Run our
  // form alter afterwards so the Studio can extend that contributed element
  // without patching ai_media_image.
  if ($hook === 'form_alter' && isset($implementations['ai_image_studio'])) {
    $implementation = $implementations['ai_image_studio'];
    unset($implementations['ai_image_studio']);
    $implementations['ai_image_studio'] = $implementation;
  }
}

/**
 * Implements hook_form_alter().
 */
function ai_image_studio_form_alter(
  array &$form,
  FormStateInterface $form_state,
  string $form_id,
): void {
  $supported_forms = [
    'media_image_add_form',
    'media_library_add_form_upload',
    'media_library_add_form_dropzonejs',
  ];
  if (!in_array($form_id, $supported_forms, TRUE)
    || !\Drupal::currentUser()->hasPermission('access ai image studio')) {
    return;
  }

  if (!isset($form['image_source']['#options'])) {
    $form['image_source'] = [
      '#type' => 'select',
      '#title' => t('Image Source'),
      '#weight' => -1,
      '#options' => [
        'upload' => t('Upload Image'),
      ],
      '#default_value' => 'upload',
      '#states' => [
        'invisible' => [
          'li.media-library-add-form__media' => ['!value' => ''],
        ],
      ],
    ];
  }
  $form['image_source']['#options']['ai_image_studio'] = t(
    'Create in AI Image Studio',
  );

  // Keep each source's controls isolated. ai_media_image's original states
  // only distinguish Upload from its own AI source.
  if (isset($form['ai_media_image'])) {
    $form['ai_media_image']['#states'] = [
      'visible' => [
        'select[name="image_source"]' => ['value' => 'ai'],
      ],
    ];
  }
  $upload_states = [
    'visible' => [
      'select[name="image_source"]' => ['value' => 'upload'],
    ],
  ];
  if ($form_id === 'media_image_add_form') {
    $media_type = MediaType::load('image');
    $image_field = $media_type?->getSource()
      ->getSourceFieldDefinition($media_type)
      ->getName();
    if ($image_field && isset($form[$image_field])) {
      $form[$image_field]['#states'] = $upload_states;
      $form[$image_field]['widget'][0]['#required'] = FALSE;
    }
  }
  elseif (isset($form['container'])) {
    $form['container']['#states'] = $upload_states;
  }

  $compact = \Drupal::service('ai_image_studio.compact_media_form');
  $form['ai_image_studio_compact'] = $compact->build($form_state);
  $form['#validate'][] = 'ai_image_studio_media_source_validate';
}

/**
 * Validates compact Studio actions and prevents an empty Media submission.
 */
function ai_image_studio_media_source_validate(
  array &$form,
  FormStateInterface $form_state,
): void {
  $trigger = $form_state->getTriggeringElement();
  $action = $trigger['#studio_compact_action'] ?? NULL;
  if ($action === 'generate') {
    $values = (array) $form_state->getValue('ai_image_studio_compact');
    if (trim((string) ($values['prompt_start'] ?? '')) === ''
      && trim((string) ($values['prompt'] ?? '')) === '') {
      $form_state->setErrorByName(
        'ai_image_studio_compact][prompt_start',
        t('Enter a start prompt or select an after prompt.'),
      );
    }
    if (empty($values['model'])) {
      $form_state->setErrorByName(
        'ai_image_studio_compact][model',
        t('Select a configured provider and model.'),
      );
    }
    return;
  }
  if ($action === 'publish') {
    $values = (array) $form_state->getValue([
      'ai_image_studio_compact',
      'preview',
    ]);
    if (trim((string) ($values['name'] ?? '')) === '') {
      $form_state->setErrorByName(
        'ai_image_studio_compact][preview][name',
        t('Enter a Media name.'),
      );
    }
    $require_alt = \Drupal::config('ai_image_studio.settings')
      ->get('require_image_alt') !== FALSE;
    if ($require_alt && trim((string) ($values['alt'] ?? '')) === '') {
      $form_state->setErrorByName(
        'ai_image_studio_compact][preview][alt',
        t('Enter alternative text for the image.'),
      );
    }
    return;
  }
  if ($form_state->getValue('image_source') === 'ai_image_studio'
    && $action === NULL) {
    $form_state->setError(
      $form['image_source'],
      t('Generate an image with the compact AI Image Studio form below.'),
    );
  }
}

/**
 * Submit callback for compact Studio generation.
 */
function ai_image_studio_compact_generate_submit(
  array &$form,
  FormStateInterface $form_state,
): void {
  \Drupal::service('ai_image_studio.compact_media_form')
    ->generate($form, $form_state);
}

/**
 * AJAX callback for compact Studio generation.
 */
function ai_image_studio_compact_generate_ajax(
  array &$form,
  FormStateInterface $form_state,
): array {
  return $form['ai_image_studio_compact'];
}

/**
 * Submit callback for publishing a compact Studio result.
 */
function ai_image_studio_compact_publish_submit(
  array &$form,
  FormStateInterface $form_state,
): void {
  \Drupal::service('ai_image_studio.compact_media_form')
    ->publish($form, $form_state);
}

/**
 * AJAX callback for publishing a compact Studio result.
 */
function ai_image_studio_compact_publish_ajax(
  array &$form,
  FormStateInterface $form_state,
): mixed {
  return \Drupal::service('ai_image_studio.compact_media_form')
    ->publishAjax($form, $form_state);
}

/**
 * Implements hook_file_download().
 */
function ai_image_studio_file_download(string $uri): array|int|null {
  $config = \Drupal::config('ai_image_studio.settings');
  $scheme = (string) ($config->get('file_scheme') ?: 'private');
  $directory = trim((string) ($config->get('file_directory') ?: 'ai-image-studio'), '/');
  if (!str_starts_with($uri, $scheme . '://' . $directory . '/')) {
    return NULL;
  }

  $files = \Drupal::entityTypeManager()
    ->getStorage('file')
    ->loadByProperties(['uri' => $uri]);
  $file = reset($files);
  if (!$file instanceof FileInterface) {
    return -1;
  }

  // A Media publication may reference a derived file, such as an image or
  // video with a permanently rendered badge, rather than the original file
  // stored on the Studio turn. Authorize those files through the Media entity
  // that owns the configured source field.
  $media_storage = \Drupal::entityTypeManager()->getStorage('media');
  foreach ([
    [
      (string) $config->get('media_bundle'),
      (string) $config->get('media_source_field'),
    ],
    [
      (string) $config->get('video_media_bundle'),
      (string) $config->get('video_media_source_field'),
    ],
  ] as [$bundle, $field]) {
    if ($bundle === '' || $field === '') {
      continue;
    }
    $media_ids = $media_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('bundle', $bundle)
      ->condition($field, $file->id())
      ->execute();
    foreach ($media_storage->loadMultiple($media_ids) as $media) {
      if ($media->access('view')) {
        return file_get_content_headers($file);
      }
    }
  }

  $turn_storage = \Drupal::entityTypeManager()->getStorage('ai_image_studio_turn');
  $file_reference = $turn_storage->getQuery()
    ->orConditionGroup()
    ->condition('image', $file->id())
    ->condition('video', $file->id())
    ->condition('source_file_ids', $file->id());
  $turn_ids = $turn_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition($file_reference)
    ->execute();
  foreach ($turn_storage->loadMultiple($turn_ids) as $turn) {
    if (!$turn->get('media_id')->isEmpty()) {
      $media = $turn->get('media_id')->entity;
      if ($media && $media->access('view')) {
        return file_get_content_headers($file);
      }
    }

    $session = $turn->get('session_id')->entity;
    if ($session && $session->access('view')) {
      return file_get_content_headers($file);
    }
  }

  return -1;
}

/**
 * Implements hook_entity_predelete().
 */
function ai_image_studio_entity_predelete(EntityInterface $entity): void {
  if ($entity->getEntityTypeId() === 'ai_image_studio_session') {
    $storage = \Drupal::entityTypeManager()->getStorage('ai_image_studio_turn');
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('session_id', $entity->id())
      ->execute();
    if ($ids) {
      $turns = $storage->loadMultiple($ids);
      $uploaded_sources = [];
      foreach ($turns as $turn) {
        foreach ($turn->get('source_file_ids')->referencedEntities() as $source) {
          if ($source instanceof FileInterface
            && str_starts_with($source->getFileUri(), 'temporary://ai-image-studio/')) {
            $uploaded_sources[(int) $source->id()] = $source;
          }
        }
      }
      $storage->delete($turns);
      foreach ($uploaded_sources as $file_id => $source) {
        $references = $storage->getQuery()
          ->accessCheck(FALSE)
          ->condition('source_file_ids', $file_id)
          ->count()
          ->execute();
        if ((int) $references === 0) {
          $source->delete();
        }
      }
    }
  }

  if ($entity->getEntityTypeId() === 'ai_image_studio_turn'
    && $entity->get('media_id')->isEmpty()) {
    foreach (['image', 'video'] as $field_name) {
      if (!$entity->get($field_name)->isEmpty()) {
        $file = $entity->get($field_name)->entity;
        if ($file instanceof FileInterface) {
          $file->delete();
        }
      }
    }

    // Queued requests make uploaded temporary source files permanent so they
    // remain available to cron. Remove a Studio-owned upload after its final
    // referencing turn is deleted, without touching Media or prior outputs.
    foreach ($entity->get('source_file_ids')->referencedEntities() as $source) {
      if ($source instanceof FileInterface
        && str_starts_with($source->getFileUri(), 'temporary://ai-image-studio/')) {
        $references = \Drupal::entityTypeManager()
          ->getStorage('ai_image_studio_turn')
          ->getQuery()
          ->accessCheck(FALSE)
          ->condition('source_file_ids', $source->id())
          ->condition('id', $entity->id(), '<>')
          ->count()
          ->execute();
        if ((int) $references === 0) {
          $source->delete();
        }
      }
    }
  }
}
