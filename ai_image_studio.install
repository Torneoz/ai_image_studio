<?php

/**
 * @file
 * Install and update hooks for AI Image Studio.
 */

declare(strict_types=1);

use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Adds persisted image generation settings to existing installations.
 */
function ai_image_studio_update_10001(): void {
  $definition = BaseFieldDefinition::create('map')
    ->setLabel(new TranslatableMarkup('Generation settings'));
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'generation_settings',
    'ai_image_studio_turn',
    'ai_image_studio',
    $definition,
  );
}

/**
 * Adds duration and cost feedback to existing image turns.
 */
function ai_image_studio_update_10002(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();

  $duration = BaseFieldDefinition::create('integer')
    ->setLabel(new TranslatableMarkup('Generation duration'))
    ->setSetting('unsigned', TRUE);
  $manager->installFieldStorageDefinition(
    'duration_ms',
    'ai_image_studio_turn',
    'ai_image_studio',
    $duration,
  );

  $cost = BaseFieldDefinition::create('decimal')
    ->setLabel(new TranslatableMarkup('Estimated cost'))
    ->setSetting('precision', 14)
    ->setSetting('scale', 8);
  $manager->installFieldStorageDefinition(
    'estimated_cost',
    'ai_image_studio_turn',
    'ai_image_studio',
    $cost,
  );

  $source = BaseFieldDefinition::create('list_string')
    ->setLabel(new TranslatableMarkup('Cost source'))
    ->setSettings([
      'allowed_values' => [
        'reported' => new TranslatableMarkup('Provider reported'),
        'estimated' => new TranslatableMarkup('Estimated'),
        'unavailable' => new TranslatableMarkup('Unavailable'),
      ],
    ])
    ->setDefaultValue('unavailable');
  $manager->installFieldStorageDefinition(
    'cost_source',
    'ai_image_studio_turn',
    'ai_image_studio',
    $source,
  );
}

/**
 * Adds provider-reported token usage to existing image turns.
 */
function ai_image_studio_update_10003(): void {
  $definition = BaseFieldDefinition::create('map')
    ->setLabel(new TranslatableMarkup('Token usage'));
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'token_usage',
    'ai_image_studio_turn',
    'ai_image_studio',
    $definition,
  );
}

/**
 * Adds video output storage and video operation values.
 */
function ai_image_studio_update_10004(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();

  $video = BaseFieldDefinition::create('file')
    ->setLabel(new TranslatableMarkup('Generated video'))
    ->setSetting('file_extensions', 'mp4')
    ->setSetting('file_directory', 'ai-image-studio');
  $manager->installFieldStorageDefinition(
    'video',
    'ai_image_studio_turn',
    'ai_image_studio',
    $video,
  );

  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('ai_image_studio_turn');
  $operation = $definitions['operation'];
  $operation->setSetting('allowed_values', [
    'text_to_image' => new TranslatableMarkup('Text to image'),
    'image_to_image' => new TranslatableMarkup('Image to image'),
    'text_to_video' => new TranslatableMarkup('Text to video'),
    'image_to_video' => new TranslatableMarkup('Image to video'),
  ]);
  $manager->updateFieldStorageDefinition($operation);

  $config = \Drupal::configFactory()
    ->getEditable('ai_image_studio.settings');
  if ($config->get('video_media_bundle') === NULL) {
    $config
      ->set('video_media_bundle', 'video')
      ->set('video_media_source_field', 'field_media_video_file')
      ->save(TRUE);
  }
}

/**
 * Adds configurable Studio interface and generation defaults.
 */
function ai_image_studio_update_10005(): void {
  $config = \Drupal::configFactory()
    ->getEditable('ai_image_studio.settings');
  $defaults = [
    'generation_form_open' => TRUE,
    'image_settings_open' => TRUE,
    'video_settings_open' => TRUE,
    'show_request_metadata' => TRUE,
    'show_token_usage' => TRUE,
    'show_costs' => TRUE,
    'show_session_report' => TRUE,
    'default_output_type' => 'image',
    'default_aspect_ratio' => 'auto',
    'default_image_resolution' => 'auto',
    'default_video_resolution' => '720p',
    'default_video_duration' => 5,
    'default_transparent_background' => FALSE,
    'default_text_to_image_model' => '',
    'default_image_to_image_model' => '',
    'default_text_to_video_model' => '',
    'default_image_to_video_model' => '',
    'max_source_image_size_mb' => 20,
    'max_video_duration' => 15,
    'request_cost_warning' => 0,
    'session_cost_warning' => 0,
    'require_image_alt' => TRUE,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save(TRUE);
}

/**
 * Adds image file type and AI badge defaults.
 */
function ai_image_studio_update_10006(): void {
  $config = \Drupal::configFactory()
    ->getEditable('ai_image_studio.settings');
  $defaults = [
    'default_image_file_type' => 'png',
    'default_show_ai_badge' => FALSE,
    'default_ai_badge_text' => 'AI Image',
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save(TRUE);
}

/**
 * Adds queued generation, request grouping, and provider provenance fields.
 */
function ai_image_studio_update_10007(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $fields = [
    'source_file_id' => BaseFieldDefinition::create('entity_reference')
      ->setLabel(new TranslatableMarkup('Source file'))
      ->setSetting('target_type', 'file'),
    'request_group' => BaseFieldDefinition::create('string')
      ->setLabel(new TranslatableMarkup('Request group'))
      ->setSetting('max_length', 64),
    'provider_metadata' => BaseFieldDefinition::create('map')
      ->setLabel(new TranslatableMarkup('Provider metadata')),
    'attempt_count' => BaseFieldDefinition::create('integer')
      ->setLabel(new TranslatableMarkup('Generation attempts'))
      ->setSetting('unsigned', TRUE)
      ->setDefaultValue(0),
  ];
  foreach ($fields as $name => $definition) {
    $manager->installFieldStorageDefinition(
      $name,
      'ai_image_studio_turn',
      'ai_image_studio',
      $definition,
    );
  }

  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('ai_image_studio_turn');
  $status = $definitions['status'];
  $status->setSetting('allowed_values', [
    'pending' => new TranslatableMarkup('Pending'),
    'queued' => new TranslatableMarkup('Queued'),
    'processing' => new TranslatableMarkup('Processing'),
    'completed' => new TranslatableMarkup('Completed'),
    'failed' => new TranslatableMarkup('Failed'),
    'expired' => new TranslatableMarkup('Expired'),
    'cancelled' => new TranslatableMarkup('Cancelled'),
  ]);
  $manager->updateFieldStorageDefinition($status);

  $config = \Drupal::configFactory()
    ->getEditable('ai_image_studio.settings');
  $defaults = [
    'default_image_quality' => 'medium',
    'default_image_variations' => 1,
    'async_video_generation' => TRUE,
    'generation_retry_limit' => 3,
  ];
  foreach ($defaults as $key => $value) {
    if ($config->get($key) === NULL) {
      $config->set($key, $value);
    }
  }
  $config->save(TRUE);
}

/**
 * Adds ordered reference inputs and deferred provider request tracking.
 */
function ai_image_studio_update_10008(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $source_files = BaseFieldDefinition::create('entity_reference')
    ->setLabel(new TranslatableMarkup('Ordered source files'))
    ->setSetting('target_type', 'file')
    ->setCardinality(BaseFieldDefinition::CARDINALITY_UNLIMITED);
  $manager->installFieldStorageDefinition(
    'source_file_ids',
    'ai_image_studio_turn',
    'ai_image_studio',
    $source_files,
  );
  $request_id = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Provider request ID'))
    ->setSetting('max_length', 255);
  $manager->installFieldStorageDefinition(
    'provider_request_id',
    'ai_image_studio_turn',
    'ai_image_studio',
    $request_id,
  );

  $definitions = \Drupal::service('entity_field.manager')
    ->getFieldStorageDefinitions('ai_image_studio_turn');
  $operation = $definitions['operation'];
  $allowed = $operation->getSetting('allowed_values');
  $allowed['reference_to_video'] = new TranslatableMarkup('Reference to video');
  $operation->setSetting('allowed_values', $allowed);
  $manager->updateFieldStorageDefinition($operation);
}

/**
 * Adds automatic image-level adjustment defaults.
 */
function ai_image_studio_update_10009(): void {
  $config = \Drupal::configFactory()
    ->getEditable('ai_image_studio.settings');
  if ($config->get('default_auto_levels') === NULL) {
    $config->set('default_auto_levels', FALSE)->save(TRUE);
  }
}

/**
 * Installs the reusable Studio prompt type and default prompt.
 */
function ai_image_studio_update_10010(): void {
  /** @var \Drupal\ai\Service\AiPromptManager $prompt_manager */
  $prompt_manager = \Drupal::service('ai.prompt_manager');
  $prompt_manager->upsertFromConfigInstall('ai_image_studio');
}

/**
 * Adds image and video fidelity prompts to the Studio prompt library.
 */
function ai_image_studio_update_10011(): void {
  /** @var \Drupal\ai\Service\AiPromptManager $prompt_manager */
  $prompt_manager = \Drupal::service('ai.prompt_manager');
  $prompt_manager->upsertFromConfigInstall('ai_image_studio');
}

/**
 * Adds a distinct default badge label for generated videos.
 */
function ai_image_studio_update_10012(): void {
  $config = \Drupal::configFactory()
    ->getEditable('ai_image_studio.settings');
  if ($config->get('default_video_ai_badge_text') === NULL) {
    $config->set('default_video_ai_badge_text', 'AI Video')->save(TRUE);
  }
}

/**
 * Displays generated assets as previews in the default Turns View.
 */
function ai_image_studio_update_10013(): void {
  \Drupal::service('config.installer')
    ->installDefaultConfig('module', 'ai_image_studio');

  $view = \Drupal::configFactory()
    ->getEditable('views.view.image_studio_turns');
  if ($view->isNew()) {
    return;
  }
  $view
    ->set(
      'display.default.display_options.fields.image__target_id.plugin_id',
      'ai_image_studio_image_preview',
    )
    ->set(
      'display.default.display_options.fields.video__target_id.plugin_id',
      'ai_image_studio_video_preview',
    )
    ->save(TRUE);
}

/**
 * Restores missing Studio prompt configuration after config synchronization.
 */
function ai_image_studio_update_10014(): void {
  \Drupal::service('config.installer')
    ->installDefaultConfig('module', 'ai_image_studio');
}
