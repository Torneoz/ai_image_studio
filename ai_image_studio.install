/**
 * Adds immutable request snapshots, replay provenance, and replay state.
 */
function ai_image_studio_update_10019(): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $turn_fields = [
    'sequence' => BaseFieldDefinition::create('integer')
      ->setLabel(new TranslatableMarkup('Session sequence'))
      ->setSetting('unsigned', TRUE),
    'replay_of' => BaseFieldDefinition::create('entity_reference')
      ->setLabel(new TranslatableMarkup('Replay of'))
      ->setSetting('target_type', 'ai_image_studio_turn'),
    'requested_generation_settings' => BaseFieldDefinition::create('map')
      ->setLabel(new TranslatableMarkup('Requested generation settings')),
  ];
  foreach ($turn_fields as $name => $definition) {
    $manager->installFieldStorageDefinition($name, 'ai_image_studio_turn', 'ai_image_studio', $definition);
  }
  $session_fields = [
    'replay_source_session_id' => BaseFieldDefinition::create('entity_reference')
      ->setLabel(new TranslatableMarkup('Replay source session'))
      ->setSetting('target_type', 'ai_image_studio_session'),
    'replay_state' => BaseFieldDefinition::create('map')
      ->setLabel(new TranslatableMarkup('Replay state')),
  ];
  foreach ($session_fields as $name => $definition) {
    $manager->installFieldStorageDefinition($name, 'ai_image_studio_session', 'ai_image_studio', $definition);
  }

  $storage = \Drupal::entityTypeManager()->getStorage('ai_image_studio_turn');
  $session_ids = \Drupal::entityQuery('ai_image_studio_session')->accessCheck(FALSE)->execute();
  foreach ($session_ids as $session_id) {
    $ids = $storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('session_id', $session_id)
      ->sort('created', 'ASC')
      ->sort('id', 'ASC')
      ->execute();
    $sequence = 0;
    $groups = [];
    foreach ($storage->loadMultiple($ids) as $turn) {
      $group = (string) ($turn->get('request_group')->value ?: 'turn:' . $turn->id());
      if (!isset($groups[$group])) {
        $groups[$group] = ++$sequence;
      }
      $turn->set('sequence', $groups[$group]);
      $settings = (array) ($turn->get('generation_settings')->first()?->getValue() ?? []);
      $turn->set('requested_generation_settings', $settings);
      $turn->save();
    }
  }
}

/**
 * Uses extracted video frames as thumbnails for published Media items.
 */
function ai_image_studio_update_10020(): void {
  $turn_storage = \Drupal::entityTypeManager()
    ->getStorage('ai_image_studio_turn');
  $turn_ids = $turn_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('video.target_id', NULL, 'IS NOT NULL')
    ->condition('last_frame.target_id', NULL, 'IS NOT NULL')
    ->condition('media_id.target_id', NULL, 'IS NOT NULL')
    ->execute();

  foreach ($turn_storage->loadMultiple($turn_ids) as $turn) {
    $media = $turn->get('media_id')->entity;
    $frame = $turn->get('last_frame')->entity;
    if (!$media instanceof MediaInterface
      || !$frame instanceof FileInterface) {
      continue;
    }
    $media->set('thumbnail', [
      'target_id' => $frame->id(),
      'alt' => $media->label(),
    ]);
    $media->save();
  }
}

/**
 * Normalizes installed Views configuration for supported core schemas.
 */
function ai_image_studio_update_10021(): void {
  $config_factory = \Drupal::configFactory();
  foreach (['image_studio_sessions', 'image_studio_turns'] as $view_id) {
    $view = $config_factory->getEditable('views.view.' . $view_id);
    if ($view->isNew()) {
      continue;
    }
    $fields = (array) $view->get('display.default.display_options.fields');
    foreach ($fields as $field_id => $field) {
      if (isset($field['settings']['time_diff']['description'])) {
        unset($field['settings']['time_diff']['description']);
        $fields[$field_id] = $field;
      }
    }
    $view->set('display.default.display_options.fields', $fields)->save(TRUE);
  }
}

/**
 * Adds badge position and preview class defaults.
 */
function ai_image_studio_update_10022(): void {
  $config = \Drupal::configFactory()->getEditable('ai_image_studio.settings');
  if ($config->get('default_ai_badge_position') === NULL) {
    $config->set('default_ai_badge_position', 'bottom-right');
  }
  if ($config->get('default_ai_badge_class') === NULL) {
    $config->set('default_ai_badge_class', '');
  }
  $config->save(TRUE);
}

/**
 * Adds stable machine names to Studio sessions.
 */
function ai_image_studio_update_10023(array &$sandbox): void {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $storage = \Drupal::entityTypeManager()->getStorage('ai_image_studio_session');
  if (empty($sandbox['initialized'])) {
    $definition = BaseFieldDefinition::create('string')
      ->setLabel(new TranslatableMarkup('Machine name'))
      ->setSetting('max_length', 100);
    $manager->installFieldStorageDefinition(
      'machine_name',
      'ai_image_studio_session',
      'ai_image_studio',
      $definition,
    );
    $sandbox['initialized'] = TRUE;
    $sandbox['last_id'] = 0;
    $sandbox['processed'] = 0;
    $sandbox['total'] = (int) $storage->getQuery()
      ->accessCheck(FALSE)
      ->count()
      ->execute();
  }

  /** @var \Drupal\ai_image_studio\Service\SessionMachineName $machine_names */
  $machine_names = \Drupal::service('ai_image_studio.session_machine_name');
  $ids = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('id', $sandbox['last_id'], '>')
    ->sort('id', 'ASC')
    ->range(0, 50)
    ->execute();
  foreach ($storage->loadMultiple($ids) as $session) {
    $machine_name = $machine_names->normalize((string) $session->label());
    if ($machine_name === '') {
      $machine_name = 'session-' . $session->id();
    }
    elseif ($machine_names->exists($machine_name, (int) $session->id())) {
      $suffix = '-' . $session->id();
      $machine_name = mb_substr($machine_name, 0, 100 - strlen($suffix)) . $suffix;
    }
    $session->set('machine_name', $machine_name);
    $session->save();
    $sandbox['last_id'] = (int) $session->id();
    $sandbox['processed']++;
  }

  if ($sandbox['processed'] < $sandbox['total']) {
    $sandbox['#finished'] = $sandbox['processed'] / $sandbox['total'];
    return;
  }
  $required_definition = BaseFieldDefinition::create('string')
    ->setLabel(new TranslatableMarkup('Machine name'))
    ->setRequired(TRUE)
    ->setSetting('max_length', 100)
    ->addConstraint('UniqueField');
  $manager->updateFieldStorageDefinition($required_definition);
  $sandbox['#finished'] = 1;
}

/**
 * Copies private files attached to Studio Media into public storage.
 */
function ai_image_studio_update_10024(array &$sandbox): void {
  $turn_storage = \Drupal::entityTypeManager()->getStorage('ai_image_studio_turn');
  if (empty($sandbox['initialized'])) {
    $sandbox['initialized'] = TRUE;
    $sandbox['last_id'] = 0;
    $sandbox['processed'] = 0;
    $sandbox['total'] = (int) $turn_storage->getQuery()
      ->accessCheck(FALSE)
      ->condition('media_id.target_id', NULL, 'IS NOT NULL')
      ->count()
      ->execute();
  }

  $ids = $turn_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('media_id.target_id', NULL, 'IS NOT NULL')
    ->condition('id', $sandbox['last_id'], '>')
    ->sort('id', 'ASC')
    ->range(0, 25)
    ->execute();
  /** @var \Drupal\ai_image_studio\Service\MediaFilePublisher $publisher */
  $publisher = \Drupal::service('ai_image_studio.media_file_publisher');
  /** @var \Drupal\ai_image_studio\Service\SessionMachineName $machine_names */
  $machine_names = \Drupal::service('ai_image_studio.session_machine_name');

  foreach ($turn_storage->loadMultiple($ids) as $turn) {
    $media = $turn->get('media_id')->entity;
    $session = $turn->get('session_id')->entity;
    if (!$media instanceof MediaInterface || $session === NULL) {
      $sandbox['last_id'] = (int) $turn->id();
      $sandbox['processed']++;
      continue;
    }
    $machine_name = trim((string) $session->get('machine_name')->value);
    if ($machine_name === '') {
      $machine_name = $machine_names->generate((string) $session->label(), (int) $session->id());
    }
    $source_field = (string) ($media->getSource()->getConfiguration()['source_field'] ?? '');
    $public_source = NULL;
    $private_source_id = NULL;
    if ($source_field !== '' && $media->hasField($source_field)) {
      $source_item = $media->get($source_field)->first();
      $source_file = $source_item?->entity;
      if ($source_file instanceof FileInterface
        && str_starts_with($source_file->getFileUri(), 'private://')) {
        $private_source_id = (int) $source_file->id();
        $is_video = !$turn->get('video')->isEmpty();
        $master_id = (int) $turn->get($is_video ? 'video' : 'image')->target_id;
        $badged = $master_id !== $private_source_id;
        $extension = pathinfo($source_file->getFilename(), PATHINFO_EXTENSION);
        $filename = sprintf(
          '%s_turn_%d%s.%s',
          $machine_name,
          $turn->id(),
          $badged ? '_badged' : '',
          $extension,
        );
        $public_source = $publisher->copyToPublic(
          $source_file,
          $media->get($source_field),
          ['media' => $media],
          $filename,
        );
        $source_value = $source_item->getValue();
        $source_value['target_id'] = $public_source->id();
        $media->set($source_field, $source_value);
        $media->save();
      }
    }

    if ($media->hasField('thumbnail')) {
      $thumbnail_item = $media->get('thumbnail')->first();
      $thumbnail = $thumbnail_item?->entity;
      if ($thumbnail instanceof FileInterface
        && str_starts_with($thumbnail->getFileUri(), 'private://')) {
        if ($public_source instanceof FileInterface
          && (int) $thumbnail->id() === $private_source_id) {
          $public_thumbnail = $public_source;
        }
        else {
          $extension = pathinfo($thumbnail->getFilename(), PATHINFO_EXTENSION);
          $public_thumbnail = $publisher->copyToPublic(
            $thumbnail,
            $media->get('thumbnail'),
            ['media' => $media],
            sprintf('%s_turn_%d_last_frame.%s', $machine_name, $turn->id(), $extension),
          );
        }
        $thumbnail_value = $thumbnail_item->getValue();
        $thumbnail_value['target_id'] = $public_thumbnail->id();
        $media->set('thumbnail', $thumbnail_value);
        $media->save();
      }
    }

    $sandbox['last_id'] = (int) $turn->id();
    $sandbox['processed']++;
  }

  if ($sandbox['processed'] < $sandbox['total']) {
    $sandbox['#finished'] = $sandbox['processed'] / $sandbox['total'];
    return;
  }
  $sandbox['#finished'] = 1;
}
