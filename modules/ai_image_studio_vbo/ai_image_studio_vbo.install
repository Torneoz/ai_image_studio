/**
 * Installs the reusable VBO prompt type and default prompt.
 */
function ai_image_studio_vbo_update_10001(): void {
  /** @var \Drupal\ai\Service\AiPromptManager $prompt_manager */
  $prompt_manager = \Drupal::service('ai.prompt_manager');
  $prompt_manager->upsertFromConfigInstall('ai_image_studio_vbo');
}

/**
 * Renames the default content View and removes site-specific filtering.
 */
function ai_image_studio_vbo_update_10002(): void {
  \Drupal::service('config.installer')
    ->installDefaultConfig('module', 'ai_image_studio_vbo');
  \Drupal::configFactory()
    ->getEditable('views.view.image_studio_test')
    ->delete();
}

/**
 * Restores missing VBO prompt configuration after config synchronization.
 */
function ai_image_studio_vbo_update_10003(): void {
  \Drupal::service('config.installer')
    ->installDefaultConfig('module', 'ai_image_studio_vbo');
}

/**
 * Restores managed VBO prompt configuration removed by configuration imports.
 */
function ai_image_studio_vbo_update_10004(): void {
  /** @var \Drupal\ai\Service\AiPromptManager $prompt_manager */
  $prompt_manager = \Drupal::service('ai.prompt_manager');
  $prompt_manager->upsertFromConfigInstall('ai_image_studio_vbo');
  _ai_image_studio_vbo_install_views();
}

/**
 * Restores the VBO View missed by recipe-based module installation.
 */
function ai_image_studio_vbo_update_10005(): void {
  _ai_image_studio_vbo_install_views();
}
