<?php

declare(strict_types=1);

use Drupal\ai_storyboard\Entity\Storyboard;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\StringTranslation\TranslatableMarkup;

/**
 * Adds the reusable after-prompt field to existing storyboards.
 */
function ai_storyboard_update_10001(): string {
  $definition = BaseFieldDefinition::create('string_long')
    ->setLabel(new TranslatableMarkup('After prompt'))
    ->setDescription(new TranslatableMarkup('Instructions appended to every generated shot prompt.'));
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'after_prompt',
    'ai_storyboard',
    'ai_storyboard',
    $definition,
  );
  return 'Added the storyboard after-prompt field.';
}

/**
 * Adds the dedicated character bible to existing storyboard projects.
 */
function ai_storyboard_update_10002(): void {
  $entity_type = \Drupal::entityTypeManager()->getDefinition('ai_storyboard');
  $field = Storyboard::baseFieldDefinitions($entity_type)['character_bible'];
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'character_bible',
    'ai_storyboard',
    'ai_storyboard',
    $field,
  );
}

/**
 * Retained as a no-op for sites that have not yet run this update.
 */
function ai_storyboard_update_10003(): void {
}

/**
 * Moves storyboard jobs into the shared AI Image Studio Bulk Jobs tables.
 */
function ai_storyboard_update_10004(): string {
  $database = \Drupal::database();
  $schema = $database->schema();
  if (!$schema->tableExists('ai_storyboard_bulk_job')) {
    return 'Storyboard generation now uses the shared Bulk Jobs facility.';
  }

  \Drupal::queue('ai_storyboard_frame_generation')->deleteQueue();
  $job_map = [];
  $jobs = $database->select('ai_storyboard_bulk_job', 'j')
    ->fields('j')->execute()->fetchAll();
  $storyboards = \Drupal::entityTypeManager()->getStorage('ai_storyboard');
  $shots = \Drupal::entityTypeManager()->getStorage('ai_storyboard_shot');
  foreach ($jobs as $job) {
    $storyboard = $storyboards->load((int) $job->storyboard_id);
    $configuration = json_encode([
      'source_type' => 'storyboard',
      'storyboard_id' => (int) $job->storyboard_id,
    ], JSON_THROW_ON_ERROR);
    $existing = $database->select('ai_image_studio_vbo_job', 'j')
      ->fields('j', ['id'])->condition('uuid', $job->uuid)
      ->execute()->fetchField();
    $job_map[(int) $job->id] = $existing === FALSE
      ? (int) $database->insert('ai_image_studio_vbo_job')
        ->fields([
          'uuid' => $job->uuid,
          'uid' => (int) $job->uid,
          'session_id' => $storyboard
            ? ($storyboard->get('studio_session_id')->target_id ?: NULL)
            : NULL,
          'prompt_template' => 'Storyboard frames: ' . ($storyboard?->label() ?? $job->storyboard_id),
          'configuration' => $configuration,
          'status' => $job->status,
          'created' => (int) $job->created,
          'changed' => (int) $job->changed,
        ])->execute()
      : (int) $existing;
  }

  if ($schema->tableExists('ai_storyboard_bulk_item')) {
    $items = $database->select('ai_storyboard_bulk_item', 'i')
      ->fields('i')->orderBy('id')->execute()->fetchAll();
    foreach ($items as $item) {
      $shot = $shots->load((int) $item->shot_id);
      $status = $item->status === 'processing' ? 'queued' : $item->status;
      $shared_job_id = $job_map[(int) $item->job_id];
      $existing = $database->select('ai_image_studio_vbo_item', 'i')
        ->fields('i', ['id'])
        ->condition('job_id', $shared_job_id)
        ->condition('node_id', (int) $item->shot_id)
        ->condition('langcode', 'und')
        ->execute()->fetchField();
      $item_id = $existing === FALSE
        ? (int) $database->insert('ai_image_studio_vbo_item')
          ->fields([
            'job_id' => $shared_job_id,
            'node_id' => (int) $item->shot_id,
            'revision_id' => NULL,
            'langcode' => 'und',
            'label' => $item->label,
            'resolved_prompt' => (string) ($shot?->get('image_prompt')->value ?? ''),
            'source_file_id' => NULL,
            'turn_id' => $item->turn_id ? (int) $item->turn_id : NULL,
            'media_id' => NULL,
            'status' => $status,
            'attempt_count' => (int) $item->attempt_count,
            'error_message' => $item->error_message,
            'created' => (int) $item->created,
            'changed' => (int) $item->changed,
          ])->execute()
        : (int) $existing;
      if ($status === 'queued') {
        \Drupal::queue('ai_storyboard_frame_generation')
          ->createItem(['item_id' => $item_id]);
      }
    }
    $schema->dropTable('ai_storyboard_bulk_item');
  }
  $schema->dropTable('ai_storyboard_bulk_job');
  return 'Migrated storyboard generation into the shared Bulk Jobs facility.';
}

/**
 * Adds configurable video-sequence fields to storyboards and shots.
 */
function ai_storyboard_update_10005(): string {
  $update_manager = \Drupal::entityDefinitionUpdateManager();
  $storyboard_type = \Drupal::entityTypeManager()->getDefinition('ai_storyboard');
  $storyboard_fields = Storyboard::baseFieldDefinitions($storyboard_type);
  foreach ([
    'video_model',
    'video_sequence_mode',
    'video_duration',
    'video_resolution',
    'video_prompt',
  ] as $field_name) {
    $update_manager->installFieldStorageDefinition(
      $field_name,
      'ai_storyboard',
      'ai_storyboard',
      $storyboard_fields[$field_name],
    );
  }

  $shot_type = \Drupal::entityTypeManager()->getDefinition('ai_storyboard_shot');
  $shot_fields = \Drupal\ai_storyboard\Entity\StoryboardShot::baseFieldDefinitions($shot_type);
  $update_manager->installFieldStorageDefinition(
    'video_turn_id',
    'ai_storyboard_shot',
    'ai_storyboard',
    $shot_fields['video_turn_id'],
  );
  return 'Added configurable storyboard video sequences.';
}

/**
 * Adds project audio direction for video generation.
 */
function ai_storyboard_update_10006(): string {
  $type = \Drupal::entityTypeManager()->getDefinition('ai_storyboard');
  $fields = Storyboard::baseFieldDefinitions($type);
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition(
    'audio_prompt', 'ai_storyboard', 'ai_storyboard', $fields['audio_prompt'],
  );
  return 'Added the project audio prompt for video generation.';
}
