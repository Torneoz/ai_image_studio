<?php

/**
 * @file
 * Installs persistent narration project and chapter storage.
 */

declare(strict_types=1);

/**
 * Installs project and chapter entities for existing AI Narration sites.
 */
function ai_narration_update_10001(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $types = \Drupal::entityTypeManager();
  foreach (['ai_narration_project', 'ai_narration_chapter'] as $id) {
    $manager->installEntityType($types->getDefinition($id));
  }
  return 'Installed AI Narration project and chapter storage.';
}

function ai_narration_update_10002(): string {
  $type = \Drupal::entityTypeManager()->getDefinition('ai_narration_project');
  $field = \Drupal\ai_narration\Entity\NarrationProject::baseFieldDefinitions($type)['voice'];
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('voice', 'ai_narration_project', 'ai_narration_project', $field);
  return 'Added the narration project default voice field.';
}

function ai_narration_update_10003(): string {
  $type = \Drupal::entityTypeManager()->getDefinition('ai_narration_project');
  $fields = \Drupal\ai_narration\Entity\NarrationProject::baseFieldDefinitions($type);
  foreach (['format', 'speed', 'text_normalization'] as $name) {
    \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition($name, 'ai_narration_project', 'ai_narration_project', $fields[$name]);
  }
  return 'Added narration project output defaults.';
}

/**
 * Adds persistent last-result fields to narration chapters.
 */
function ai_narration_update_10004(): string {
  $type = \Drupal::entityTypeManager()->getDefinition('ai_narration_chapter');
  $fields = \Drupal\ai_narration\Entity\NarrationChapter::baseFieldDefinitions($type);
  foreach (['last_generated_audio', 'generation_metadata'] as $name) {
    \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition($name, 'ai_narration_chapter', 'ai_narration_chapter', $fields[$name]);
  }
  return 'Added persistent last-generation audio and metadata fields to narration chapters.';
}

/**
 * Uses the narration audio-player formatter on the Chapter full display.
 */
function ai_narration_update_10005(): string {
  \Drupal::service('entity_field.manager')->clearCachedFieldDefinitions();
  return 'Enabled the Chapter last-generated audio player display default.';
}

/**
 * Adds source provenance fields for narration chapter text snapshots.
 */
function ai_narration_update_10006(): string {
  $type = \Drupal::entityTypeManager()->getDefinition('ai_narration_chapter');
  $fields = \Drupal\ai_narration\Entity\NarrationChapter::baseFieldDefinitions($type);
  foreach (['source_type', 'source_url', 'source_entity_type', 'source_entity_id', 'source_label', 'source_fetched'] as $name) {
    \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition($name, 'ai_narration_chapter', 'ai_narration_chapter', $fields[$name]);
  }
  return 'Added narration chapter text-source provenance fields.';
}

/** Installs optional Edition and reusable Promo entities. */
function ai_narration_update_10007(): string {
  $manager = \Drupal::entityDefinitionUpdateManager();
  $types = \Drupal::entityTypeManager();
  foreach (['ai_narration_edition', 'ai_narration_promo'] as $id) {
    $manager->installEntityType($types->getDefinition($id));
  }
  return 'Installed AI Narration edition and promo storage.';
}

/** Adds the optional Edition relationship to existing Chapters. */
function ai_narration_update_10008(): string {
  $type = \Drupal::entityTypeManager()->getDefinition('ai_narration_chapter');
  $field = \Drupal\ai_narration\Entity\NarrationChapter::baseFieldDefinitions($type)['edition_id'];
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('edition_id', 'ai_narration_chapter', 'ai_narration_chapter', $field);
  return 'Added optional Edition references to narration Chapters.';
}

/** Adds Project-level joined narration audio. */
function ai_narration_update_10009(): string {
  $type = \Drupal::entityTypeManager()->getDefinition('ai_narration_project');
  $field = \Drupal\ai_narration\Entity\NarrationProject::baseFieldDefinitions($type)['joined_audio'];
  \Drupal::entityDefinitionUpdateManager()->installFieldStorageDefinition('joined_audio', 'ai_narration_project', 'ai_narration_project', $field);
  return 'Added joined chapter audio to narration projects.';
}
